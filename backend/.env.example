# Copy to .env (git-ignored) or run `uv run mijhar init-env` to generate real values.
# Never commit .env. Every value below is a placeholder.
MIJHAR_SIGNING_SECRET=<32+ random chars>
# name:sha256-hex-of-key  (comma separated)
MIJHAR_REVIEWERS=<reviewer-id>:<sha256-of-reviewer-key>
MIJHAR_CLIENT_KEYS=<client-name>:<sha256-of-api-key>
# Optional
# MIJHAR_DATA_DIR=./runs
# MIJHAR_CORS_ORIGINS=https://your-ui.vercel.app   # cloud only
# OPENROUTER_API_KEY=
# MIJHAR_MODEL=google/gemma-4-31b-it:free           # pipeline model (course default free model)
# MIJHAR_AGENT_MODEL=google/gemma-4-31b-it:free     # agent model: MUST support tool calling
# MIJHAR_AGENT_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# MIJHAR_PIPELINE_LLM=1             # 0 = pipeline on rules-v1 while the agent uses the model (saves ~15 requests per audit)
# MIJHAR_CACHE=1                    # replay identical model requests from disk (saves quota; warm it before a demo)
# MIJHAR_API_SHAPE=responses                        # or chat
# MIJHAR_DENSE=hash                 # hash (default, calibrated) | openrouter | auto | model2vec
# MIJHAR_DENSE_FLOOR=0.3            # neural cosine noise floor; UNCALIBRATED, tune after running evals
# MIJHAR_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
# MIJHAR_MAX_EMBED_CALLS=300
# MIJHAR_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free   # pipeline: second model if the first is removed or rate-limited
# MIJHAR_MAX_LLM_CALLS=150           # hard cap on model requests per audit run (retries included)
# MIJHAR_ALLOW_LIVE=1               # lets the HTTP API accept {"live": true}. Off by default (PDPL)
