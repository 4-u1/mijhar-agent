# Hugging Face Space (Docker SDK). Build context = the Space root, which holds the backend files.
FROM python:3.12-slim
RUN pip install --no-cache-dir uv && useradd -m -u 1000 user
WORKDIR /home/user/app
COPY --chown=user pyproject.toml uv.lock ./
COPY --chown=user mijhar ./mijhar
RUN uv sync --frozen --no-dev && chown -R user /home/user/app
USER user
ENV PATH="/home/user/app/.venv/bin:$PATH" MIJHAR_DATA_DIR=/tmp/mijhar MIJHAR_FRAME_ANCESTORS="https://huggingface.co" \
    MIJHAR_CORS_ORIGINS="" PYTHONUNBUFFERED=1
EXPOSE 7860
CMD ["uvicorn", "mijhar.api:app", "--host", "0.0.0.0", "--port", "7860"]
